        <joint armature="0.032"/>
        <position kp="40" kv="2.5" forcerange="-28 28"/>
      </default>
      <default class="dm4310">
        <joint armature="0.0018"/>
        <position kp="10" kv="1" forcerange="-10 10"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" material="black"/>
      </default>
      <default class="collision">
        <geom group="3" type="capsule"/>
        <default class="finger_body_collision">
          <geom type="box" rgba="0.381493 0.492734 0.780446 1"/>
        </default>
        <default class="finger_collision">
          <geom type="box" condim="6" friction="1 5e-3 5e-4" solref=".01 1" priority="1"
            rgba="0.381493 0.492734 0.780446 1"/>
        </default>
      </default>
      <default class="finger">
        <!-- 0 is closed, 0.0475 m is open, both fingers slide outwards along their -z -->
        <joint type="slide" axis="0 0 -1" range="0 0.0475" armature="0.1" frictionloss="0.1"/>
        <position ctrlrange="0.0 0.0475" kp="100" kv="10" inheritrange="0"/>
      </default>
    </default>
  </default>

