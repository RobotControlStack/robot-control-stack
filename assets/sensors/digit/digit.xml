<mujoco model="digit">
    <extension>
        <plugin plugin="mujoco.sensor.touch_grid"/>
    </extension>
    <compiler angle="radian" meshdir="assets"/>

    <asset>
        <mesh name="digit_finger" file="digit_finger.obj"/>
        <mesh name="digit_finger_attachment_collision" file="digit_finger_attachment_collision.stl"/>
        <mesh name="digit_finger_backplate_collision" file="digit_finger_backplate_collision.stl"/>
        <mesh name="digit_sensor_no_backplate" file="digit_sensor_no_backplate.obj"/>
        <mesh name="digit_sensor_no_backplate_collision" file="digit_sensor_no_backplate_collision.stl"/>
        <mesh name="digit_sensor_pad" file="digit_sensor_pad.obj"/>

        <material name="white" rgba="1 1 1 1"/>
        <material name="black" rgba="0.2 0.2 0.2 1"/>
        <material name="grey_material" rgba="0.776 0.776 0.776 1"/>
    </asset>

    <default>
        <default class="digit">
            <joint armature="0.1" damping="1"/>
            <default class="finger">
                <joint axis="0 1 0" type="slide" range="0 0.04" limited="true"/>
            </default>
            <default class="visual">
                <geom type="mesh" group="2" contype="0" conaffinity="0"/>
            </default>
            <default class="collision">
                <geom type="mesh" group="3" mass="0" density="0"/>
                <default class="fingertip_pad_collision_1">
                    <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
                </default>
                <default class="fingertip_pad_collision_2">
                    <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_3">
                    <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_4">
                    <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
                </default>
            </default>
        </default>
    </default>

    <worldbody>
        <body name="digit" childclass="digit" quat="0.9238795 0 0 -0.3826834" gravcomp="1">
            <body name="left_finger" pos="0 0.01 0.075" euler="0 3.141592653589793 3.141592653589793" gravcomp="1">
                <geom mesh="digit_finger" class="visual" material="white"/>
                <geom mesh="digit_finger_attachment_collision" class="collision" name="finger_a_left"/>
                <geom mesh="digit_finger_backplate_collision" class="collision" name="finger_b_left"/>
                <geom mesh="digit_sensor_no_backplate" class="visual" material="black"/>
                <geom mesh="digit_sensor_no_backplate_collision" class="collision" name="finger_c_left"/>
                <body name="left_taxim">
                    <geom mesh="digit_sensor_pad" class="visual" material="grey_material"/>
                    <geom mesh="digit_sensor_pad" class="collision" name="finger_1_left" friction="0.4"/>
                    <geom class="fingertip_pad_collision_1" name="fingertip_pad_collision_1_left_0" friction="2 0.05 0.0001"/>
                    <geom class="fingertip_pad_collision_2" name="fingertip_pad_collision_1_left_1" friction="2 0.05 0.0001"/>
                    <geom class="fingertip_pad_collision_3" name="fingertip_pad_collision_1_left_2" friction="2 0.05 0.0001"/>
                    <geom class="fingertip_pad_collision_4" name="fingertip_pad_collision_1_left_3" friction="2 0.05 0.0001"/>
                    <site name="left_taxim_pad" pos="0 0.0173 -0.075" euler="-1.570796 0 1.570796"/>
                </body>
                <joint name="finger_joint1" class="finger"/>
                <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
            </body>
            <body name="right_finger" pos="0 -0.01 0.075" euler="0 3.141592653589793 0" gravcomp="1">
                <geom mesh="digit_finger" class="visual" material="white"/>
                <geom mesh="digit_finger_attachment_collision" class="collision" name="finger_a_right"/>
                <geom mesh="digit_finger_backplate_collision" class="collision" name="finger_b_right"/>
                <geom mesh="digit_sensor_no_backplate" class="visual" material="black"/>
                <geom mesh="digit_sensor_no_backplate_collision" class="collision" name="finger_c_right"/>
                <body name="right_taxim">
                    <geom mesh="digit_sensor_pad" class="visual" material="grey_material"/>
                    <geom mesh="digit_sensor_pad" class="collision" name="finger_1_right" friction="0.4"/>
                    <geom class="fingertip_pad_collision_1" name="fingertip_pad_collision_1_right_0" friction="2 0.05 0.0001"/>
                    <geom class="fingertip_pad_collision_2" name="fingertip_pad_collision_1_right_1" friction="2 0.05 0.0001"/>
                    <geom class="fingertip_pad_collision_3" name="fingertip_pad_collision_1_right_2" friction="2 0.05 0.0001"/>
                    <geom class="fingertip_pad_collision_4" name="fingertip_pad_collision_1_right_3" friction="2 0.05 0.0001"/>
                    <site name="right_taxim_pad" pos="0 0.0173 -0.075" euler="-1.570796 0 1.570796"/>
                </body>
                <joint name="finger_joint2" class="finger"/>
                <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
            </body>
        </body>
    </worldbody>

    <tendon>
        <fixed name="split">
            <joint joint="finger_joint1" coef="0.5"/>
            <joint joint="finger_joint2" coef="0.5"/>
        </fixed>
    </tendon>

    <equality>
        <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    </equality>

    <actuator>
        <general
            name="hand_actuator"
            class="digit"
            tendon="split"
            forcerange="-100 100"
            ctrlrange="0 255"
            biastype="affine"
            gainprm="0.01568627451 0 0"
            biasprm="0 -100 -10"/>
    </actuator>
</mujoco>
