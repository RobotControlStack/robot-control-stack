<mujoco model="flexiv_grav">
  <compiler angle="radian" meshdir="assets/"/>

  <option impratio="10" cone="elliptic"/>

  <default>
    <default class="grav">
      <mesh scale="0.001 0.001 0.001"/>
      <joint solreflimit="0.005" solimplimit="0.95 0.99" armature="0.001" damping="0.02"/>
      <general biastype="affine"/>
      <default class="knuckle">
        <joint range="-0.155 0.7854"/>
      </default>
      <default class="finger">
        <joint range="-0.7854 0.155"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0" material="black"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <default class="pad">
          <geom type="box" priority="1" solref="0.004" solimp="0.95 0.99" rgba="0.3 0.3 0.3 1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="black" rgba="0.149 0.149 0.149 1"/>
    <mesh name="base" class="grav" file="base.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="base_collision" class="grav" file="base_collision.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="outer_bar" class="grav" file="outer_bar.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="outer_bar_collision" class="grav" file="outer_bar_collision.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="inner_bar" class="grav" file="inner_bar.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="inner_bar_collision" class="grav" file="inner_bar_collision.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="finger_mount" class="grav" file="finger_mount.stl" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="finger_tip" class="grav" file="finger_tip.obj" refquat="0.707107 0 0 -0.707107"/>
    <mesh name="finger_tip_collision" class="grav" file="finger_tip_collision.stl" refquat="0.707107 0 0 -0.707107"/>
  </asset>

  <worldbody>
    <body name="base" childclass="grav">
      <inertial pos="0 0 0.057" mass="1.05" diaginertia="0.003 0.003 0.001"/>
      <geom class="visual" mesh="base"/>
      <geom class="collision" mesh="base_collision"/>
      <site name="grav_tcp" pos="0 0 0.15" size="0.002" group="5"/>
      <site name="closed_fingers_tcp" pos="0 0 0.2" size="0.002" group="5"/>
      <body name="left_outer_bar" pos="0 -0.0325 0.0825">
        <inertial pos="0 0 0.029" mass="0.03" diaginertia="1e-05 1e-05 2e-06"/>
        <joint name="left_outer_knuckle_joint" class="knuckle" pos="0 0 0" axis="1 0 0"/>
        <geom class="visual" mesh="outer_bar"/>
        <geom class="collision" mesh="outer_bar_collision"/>
        <body name="left_finger_mount" pos="0 0 0.058">
          <inertial pos="0 0.008 0.01" mass="0.01" diaginertia="2e-06 2e-06 1e-06"/>
          <joint name="left_inner_finger_joint" class="finger" pos="0 0 0" axis="1 0 0"/>
          <geom class="visual" mesh="finger_mount"/>
          <body name="left_finger_tip" pos="0 0.01 0.0235">
            <inertial pos="0 0.005 0.018" mass="0.01" diaginertia="2e-06 2e-06 1e-06"/>
            <geom class="visual" mesh="finger_tip"/>
            <geom class="collision" mesh="finger_tip_collision"/>
            <geom name="left_pad1" class="pad" size="0.007 0.001 0.009" pos="0 0.0125 0.009"/>
            <geom name="left_pad2" class="pad" size="0.007 0.001 0.009" pos="0 0.0125 0.027"/>
            <site name="left_finger_tcp" pos="0 0.0135 0.036" size="0.002" group="5"/>
          </body>
        </body>
      </body>
      <body name="left_inner_bar" pos="0 -0.0165 0.0995">
        <inertial pos="0 0 0.029" mass="0.03" diaginertia="1e-05 1e-05 2e-06"/>
        <joint name="left_inner_knuckle_joint" class="knuckle" pos="0 0 0" axis="1 0 0"/>
        <geom class="visual" mesh="inner_bar"/>
        <geom class="collision" mesh="inner_bar_collision"/>
      </body>
      <body name="right_outer_bar" pos="0 0.0325 0.0825" quat="0 0 0 1">
        <inertial pos="0 0 0.029" mass="0.03" diaginertia="1e-05 1e-05 2e-06"/>
        <joint name="right_outer_knuckle_joint" class="knuckle" pos="0 0 0" axis="1 0 0"/>
        <geom class="visual" mesh="outer_bar"/>
        <geom class="collision" mesh="outer_bar_collision"/>
        <body name="right_finger_mount" pos="0 0 0.058">
          <inertial pos="0 0.008 0.01" mass="0.01" diaginertia="2e-06 2e-06 1e-06"/>
          <joint name="right_inner_finger_joint" class="finger" pos="0 0 0" axis="1 0 0"/>
          <geom class="visual" mesh="finger_mount"/>
          <body name="right_finger_tip" pos="0 0.01 0.0235">
            <inertial pos="0 0.005 0.018" mass="0.01" diaginertia="2e-06 2e-06 1e-06"/>
            <geom class="visual" mesh="finger_tip"/>
            <geom class="collision" mesh="finger_tip_collision"/>
            <geom name="right_pad1" class="pad" size="0.007 0.001 0.009" pos="0 0.0125 0.009"/>
            <geom name="right_pad2" class="pad" size="0.007 0.001 0.009" pos="0 0.0125 0.027"/>
            <site name="right_finger_tcp" pos="0 0.0135 0.036" size="0.002" group="5"/>
          </body>
        </body>
      </body>
      <body name="right_inner_bar" pos="0 0.0165 0.0995" quat="0 0 0 1">
        <inertial pos="0 0 0.029" mass="0.03" diaginertia="1e-05 1e-05 2e-06"/>
        <joint name="right_inner_knuckle_joint" class="knuckle" pos="0 0 0" axis="1 0 0"/>
        <geom class="visual" mesh="inner_bar"/>
        <geom class="collision" mesh="inner_bar_collision"/>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base" body2="left_outer_bar"/>
    <exclude body1="base" body2="left_inner_bar"/>
    <exclude body1="base" body2="right_outer_bar"/>
    <exclude body1="base" body2="right_inner_bar"/>
    <exclude body1="left_outer_bar" body2="left_inner_bar"/>
    <exclude body1="left_finger_tip" body2="left_inner_bar"/>
    <exclude body1="right_outer_bar" body2="right_inner_bar"/>
    <exclude body1="right_finger_tip" body2="right_inner_bar"/>
  </contact>

  <!--
    The URDF drives the linkage through a virtual finger width joint and <mimic> tags:
    the parallel bars copy the knuckle angle and the distal joint negates it, which keeps
    the finger tips parallel. MuJoCo has no mimic joints, so these are equality constraints.
  -->
  <equality>
    <joint joint1="right_outer_knuckle_joint" joint2="left_outer_knuckle_joint" polycoef="0 1 0 0 0" solref="0.005"
      solimp="0.95 0.99"/>
    <joint joint1="left_inner_knuckle_joint" joint2="left_outer_knuckle_joint" polycoef="0 1 0 0 0" solref="0.005"
      solimp="0.95 0.99"/>
    <joint joint1="right_inner_knuckle_joint" joint2="right_outer_knuckle_joint" polycoef="0 1 0 0 0" solref="0.005"
      solimp="0.95 0.99"/>
    <joint joint1="left_inner_finger_joint" joint2="left_outer_knuckle_joint" polycoef="0 -1 0 0 0" solref="0.005"
      solimp="0.95 0.99"/>
    <joint joint1="right_inner_finger_joint" joint2="right_outer_knuckle_joint" polycoef="0 -1 0 0 0" solref="0.005"
      solimp="0.95 0.99"/>
  </equality>

  <!--
    The tendon splits the actuator force equally between both knuckle joints so that the
    equality constraint only has to correct small asymmetries. Its length is the knuckle angle.
  -->
  <tendon>
    <fixed name="split">
      <joint joint="left_outer_knuckle_joint" coef="0.5"/>
      <joint joint="right_outer_knuckle_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <!--
    Position actuator whose control input is the finger opening width in meters (0 closed,
    0.1 open). The URDF maps width to knuckle angle as theta = 9.404 * width - 0.155,
    so with kp = 20 on the tendon length L the force is
    F = kp * (9.404 * ctrl - 0.155 - L) - kv * L_dot, giving gainprm = kp * 9.404
    and biasprm = (-kp * 0.155, -kp, -kv). Each knuckle receives half of F.
  -->
  <actuator>
    <general name="fingers_actuator" class="grav" tendon="split" ctrlrange="0 0.1" forcerange="-5 5" gainprm="188.08"
      biasprm="-3.1 -20 -1"/>
  </actuator>
</mujoco>
