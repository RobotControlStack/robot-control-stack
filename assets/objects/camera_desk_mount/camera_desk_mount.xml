<!-- Extendable camera desk mount (NEEWER-style clamp pole) holding the head camera.
     The origin is on the table top at the pole axis, the C-clamp grips the table edge behind it (-x).
     The pole is extended to 0.82 m, the ball head sits on top at z=0.84. -->
<mujoco model="camera_desk_mount">
  <compiler angle="radian" autolimits="true"/>

  <option cone="elliptic" impratio="10"/>

  <asset>
    <material name="matte_black" rgba="0.06 0.06 0.06 1" specular="0.2" shininess="0.3"/>
    <material name="dark_gray" rgba="0.18 0.18 0.19 1" specular="0.3" shininess="0.4"/>
  </asset>

  <default>
    <default class="camera_desk_mount">
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" material="matte_black"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="base" childclass="camera_desk_mount">
      <!-- C-clamp around the table edge -->
      <geom type="box" size="0.035 0.025 0.006" pos="-0.005 0 0.006" class="visual"/>
      <geom type="box" size="0.006 0.025 0.035" pos="-0.034 0 -0.023" class="visual"/>
      <geom type="box" size="0.035 0.025 0.006" pos="-0.005 0 -0.052" class="visual"/>
      <geom type="cylinder" size="0.006 0.012" pos="0.01 0 -0.035" material="dark_gray" class="visual"/>
      <geom type="cylinder" size="0.02 0.004" pos="0.01 0 -0.062" material="dark_gray" class="visual"/>
      <!-- telescopic pole: outer tube, collar, inner tube -->
      <geom type="cylinder" size="0.013 0.2" pos="0 0 0.212" class="visual"/>
      <geom type="cylinder" size="0.016 0.012" pos="0 0 0.41" material="dark_gray" class="visual"/>
      <geom type="cylinder" size="0.0105 0.2" pos="0 0 0.61" class="visual"/>
      <!-- ball head with 1/4" screw plate -->
      <geom type="cylinder" size="0.014 0.01" pos="0 0 0.815" material="dark_gray" class="visual"/>
      <geom type="sphere" size="0.012" pos="0 0 0.84" material="dark_gray" class="visual"/>
      <geom type="box" size="0.035 0.025 0.006" pos="-0.005 0 0.006" class="collision"/>
      <geom type="cylinder" size="0.013 0.41" pos="0 0 0.42" class="collision"/>
    </body>
  </worldbody>

</mujoco>
